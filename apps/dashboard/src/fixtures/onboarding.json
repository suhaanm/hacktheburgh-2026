    "kind": "multi",
    "options": [
     {
      "value": "submit",
      "label": "Submit a case note"
     },
     {
      "value": "send",
      "label": "Send a message to a claimant"
     },
     {
      "value": "pay",
      "label": "Make a payment"
     },
     {
      "value": "delete",
      "label": "Delete a record"
     }
    ]
   },
   {
    "id": "tone",
    "prompt": "How much detail do you want in summaries?",
    "kind": "single",
    "options": [
     {
      "value": "short",
      "label": "Short"
     },
     {
      "value": "detailed",
      "label": "Detailed"
     }
    ]
   },
   {
    "id": "pace",
    "prompt": "How fast should help fade as you improve?",
    "kind": "single",
    "options": [
     {
      "value": "slow",
      "label": "Slowly"
     },
     {
      "value": "gradual",
      "label": "Gradually"
     },
     {
      "value": "fast",
      "label": "Quickly"
     }
    ]
   },
   {
    "id": "hours",
    "prompt": "When do you usually work?",
    "kind": "hours",
    "options": []
   }
  ]
 },
