{
 "benefits-processor": {
  "role": "benefits-processor",
  "pack": {
   "name": "UK benefits processor",
   "summary": "Runs entitlement checks for households and writes the case note.",
   "extra_cogs": [
    "ENTER_HOUSEHOLD",
    "OPEN_CALCULATOR",
    "READ_RESULT",
    "CHECK_CLIFF",
    "COPY_TO_NOTE",
    "RECONCILE"
