# Copy to .env and fill in. Never commit .env.

# Local copy of the owner's Alongside project on this machine (the base for apps/desktop)
ALONGSIDE_PATH=/absolute/path/to/alongside

# Primary model provider
OPENAI_API_KEY=
# Decide these in spike S1 after listing the models the key can use. Do not guess.
# Verified usable on 7 Nov 2026 (spike S1): planner gpt-5.5, fast gpt-5.4-mini, computer use gpt-5.5
OPENAI_MODEL_PLANNER=
OPENAI_MODEL_FAST=
OPENAI_MODEL_COMPUTER_USE=

# Optional second provider (only if a key exists)
GEMINI_API_KEY=

# Optional: narrated coach and morning briefing (ElevenLabs). Off unless set.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: Auth0 for the approval gate adapter. Off unless set.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Run
UNDERSTUDY_MOCK=0
ENGINE_PORT=7700
AGENT_PORT=7710
DASHBOARD_PORT=5173
SANDBOX_PORT_BASE=7801

# Memory file location
UNDERSTUDY_HOME=~/.understudy
