# Copy to .env and fill in. Never commit .env.

# Local copy of the owner's Alongside project on this machine (the base for apps/desktop)
ALONGSIDE_PATH=/absolute/path/to/alongside

# Primary model provider
OPENAI_API_KEY=
# Decide these in spike S1 after listing the models the key can use. Do not guess.
# Verified usable on 7 Nov 2026 (spike S1): planner gpt-5.5, fast gpt-5.4-mini, computer use gpt-5.5
OPENAI_MODEL_PLANNER=
OPENAI_MODEL_FAST=
OPENAI_MODEL_COMPUTER_USE=

# Optional second provider (REQ-5). Off unless UNDERSTUDY_X_GEMINI=1; never put the key anywhere but this file.
GEMINI_API_KEY=
# Model ids come ONLY from here and are checked at boot against models.list (python -m understudy_agent.models.boot --list).
# Verified usable on 7 Nov 2026: fast = flash-lite class, accurate = flash class, live = Gemini Live.
GEMINI_MODEL_FAST=
GEMINI_MODEL_ACCURATE=
GEMINI_MODEL_LIVE=
# Optional: the model for computer-use dry runs (unset = the accurate model)
GEMINI_MODEL_COMPUTER_USE=
# Optional: interactions (default) or generate_content (the documented fallback path behind the same class)
GEMINI_API=interactions
# Optional per-million prices (US$) for the cost meter; unset = labelled assumptions in models/prices.py
# UNDERSTUDY_PRICE_GEMINI_FAST_IN=  UNDERSTUDY_PRICE_GEMINI_FAST_OUT=  UNDERSTUDY_PRICE_GEMINI_ACCURATE_IN=  UNDERSTUDY_PRICE_GEMINI_ACCURATE_OUT=
# UNDERSTUDY_PRICE_OPENAI_FAST_IN=  UNDERSTUDY_PRICE_OPENAI_FAST_OUT=
# Optional: a models.yaml that overrides the role routing table (evals/modelbench/routing.recommended.yaml is a starting point)
# UNDERSTUDY_MODELS_YAML=

# Optional: narrated coach and morning briefing (ElevenLabs). Off unless set.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Set to 1 to enable spoken nudges and the morning briefing. Off, mock mode or no key gives silence (never blocks the demo).
UNDERSTUDY_VOICE=0
# Optional: Auth0 sign-in and step-up approval in the dashboard. Off unless both VITE_ values are set.
# Public values only (SPA with PKCE). Put the VITE_ pair in apps/dashboard/.env.local (gitignored). No secret is used.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# Run
UNDERSTUDY_MOCK=0
ENGINE_PORT=7700
AGENT_PORT=7710
DASHBOARD_PORT=5173
SANDBOX_PORT_BASE=7801

# Memory file location
UNDERSTUDY_HOME=~/.understudy
