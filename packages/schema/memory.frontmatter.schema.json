{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understudy.local/schema/memory.frontmatter.schema.json",
  "title": "Understudy memory file front matter v1",
  "description": "Schema for the parsed YAML front matter of ~/.understudy/memory.md (spec 6.4). The body is Markdown with the six sections Preferences, Procedure, Routines, Corrections, Skill state, Never; unknown sections are kept. Only the worker's own actions or approvals write the file. Extra front matter keys are kept (the worker's edit wins), so additional properties are allowed.",
  "type": "object",
  "required": ["role", "revision"],
  "properties": {
    "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "revision": { "type": "integer", "minimum": 0 },
    "person": { "type": "string", "pattern": "^p_[a-z0-9]{2,16}$" },
    "created": { "type": "string", "format": "date-time" },
    "updated": { "type": "string", "format": "date-time" },
    "tone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "length": { "enum": ["short", "medium", "detailed"] },
        "voice": { "enum": ["plain", "precise", "terse", "direct", "warm"] }
      }
    },
    "pace": { "enum": ["gentle", "steady", "quick"] },
    "hours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "days"],
      "properties": {
        "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "days": { "type": "array", "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] } }
      }
    }
  },
  "additionalProperties": true
}
