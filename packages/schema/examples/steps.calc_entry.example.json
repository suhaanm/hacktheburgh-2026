{
  "schema": 1,
  "id": "calc-entry-3x",
  "role": "benefits-processor",
  "title": "Enter the household into GovCalc (site a, layout v1)",
  "created_from": "example from sandbox_sites/specs.py",
  "never": [
    "submit",
    "submit to claimant record"
  ],
  "params": {
    "adults": {
      "type": "enum",
      "source": "household.params.adults",
      "values": [
        "1",
        "2"
      ]
    },
    "adult1_age": {
      "type": "string",
      "source": "household.params.adult1_age"
    },
    "adult2_age": {
      "type": "string",
      "source": "household.params.adult2_age"
    },
    "children_ages": {
      "type": "string",
      "source": "household.params.children_ages"
    },
    "adult1_earnings_monthly": {
      "type": "string",
      "source": "household.params.adult1_earnings_monthly"
    },
    "adult2_earnings_monthly": {
      "type": "string",
      "source": "household.params.adult2_earnings_monthly"
    },
    "limited_capability": {
      "type": "enum",
      "source": "household.params.limited_capability",
      "values": [
        "no",
        "yes"
      ]
    },
    "tenure": {
      "type": "enum",
      "source": "household.params.tenure",
      "values": [
        "rent",
        "own"
      ]
    },
    "rent_monthly": {
      "type": "string",
      "source": "household.params.rent_monthly"
    },
    "bedrooms": {
      "type": "enum",
      "source": "household.params.bedrooms",
      "values": [
        "1",
        "2",
        "3",
        "4"
      ]
    },
    "savings": {
      "type": "string",
      "source": "household.params.savings"
    },
    "childcare_monthly": {
      "type": "string",
      "source": "household.params.childcare_monthly"
    },
    "site_a_start": {
      "type": "string",
      "default": "http://127.0.0.1:7801/step/1"
    }
  },
  "steps": [
    {
      "op": "goto",
      "url_param": "site_a_start",
      "precondition": {
        "always": true
      },
      "postcondition": {
        "selector_visible": "[name=\"adults\"]"
      },
      "id": "s1"
    },
    {
      "op": "select",
      "selector": "[name=\"adults\"]",
      "param": "adults",
      "precondition": {
        "selector_visible": "[name=\"adults\"]"
      },
      "postcondition": {
        "field_equals": {
          "selector": "[name=\"adults\"]",
          "param": "adults"
        }
      },
      "id": "s2"
    },
    {
      "op": "fill",
      "selector": "[name=\"your_age\"]",
      "param": "adult1_age",
      "precondition": {
        "selector_visible": "[name=\"your_age\"]"
      },
      "postcondition": {
        "field_equals": {
          "selector": "[name=\"your_age\"]",
          "param": "adult1_age"
        }
      },
      "id": "s3"
    },
    {
      "op": "fill",
      "selector": "[name=\"partner_age\"]",
      "param": "adult2_age",
      "precondition": {
        "selector_visible": "[name=\"partner_age\"]"
      },
      "postcondition": {
        "field_equals": {
          "selector": "[name=\"partner_age\"]",
          "param": "adult2_age"
        }
      },
      "id": "s4"
    },
    {
      "op": "fill",
      "selector": "[name=\"children_ages\"]",
      "param": "children_ages",
      "precondition": {
        "selector_visible": "[name=\"children_ages\"]"
      },
      "postcondition": {
        "field_equals": {
          "selector": "[name=\"children_ages\"]",
          "param": "children_ages"
        }
      },
      "id": "s5"
    },
    {
      "op": "click",
      "selector": "#continue",
      "precondition": {
        "selector_visible": "#continue"
      },
      "postcondition": {
        "selector_visible": "[name=\"your_earnings\"]"
      },
      "id": "s6"
    },
    {
      "op": "fill",
      "selector": "[name=\"your_earnings\"]",
      "param": "adult1_earnings_monthly",
      "precondition": {
        "selector_visible": "[name=\"your_earnings\"]"
      },
      "postcondition": {
        "field_equals": {
          "selector": "[name=\"your_earnings\"]",
          "param": "adult1_earnings_monthly"
        }
      },
      "id": "s7"
    },
    {
      "op": "fill",
      "selector": "[name=\"partner_earnings\"]",
      "param": "adult2_earnings_monthly",
      "precondition": {
        "selector_visible": "[name=\"partner_earnings\"]"
      },
      "postcondition": {
        "field_equals": {
          "selector": "[name=\"partner_earnings\"]",
          "param": "adult2_earnings_monthly"
        }
      },
      "id": "s8"
    },
    {
      "op": "select",
      "selector": "[name=\"limited_capability\"]",
      "param": "limited_capability",
      "precondition": {
        "selector_visible": "[name=\"limited_capability\"]"
      },
      "postcondition": {
        "field_equals": {
          "selector": "[name=\"limited_capability\"]",
          "param": "limited_capability"
        }
      },
      "id": "s9"
    },
    {
      "op": "click",
      "selector": "#continue",
      "precondition": {
        "selector_visible": "#continue"
      },
      "postcondition": {
        "selector_visible": "[name=\"tenure\"]"
      },
      "id": "s10"
    },
    {
      "op": "select",
      "selector": "[name=\"tenure\"]",
      "param": "tenure",
      "precondition": {
        "selector_visible": "[name=\"tenure\"]"
      },
      "postcondition": {
        "field_equals": {
          "selector": "[name=\"tenure\"]",
          "param": "tenure"
        }
      },
      "id": "s11"
    },
    {
      "op": "fill",
      "selector": "[name=\"rent\"]",
      "param": "rent_monthly",
      "precondition": {
        "selector_visible": "[name=\"rent\"]"
      },
      "postcondition": {
        "field_equals": {
          "selector": "[name=\"rent\"]",
          "param": "rent_monthly"
        }
      },
      "id": "s12"
    },
    {
      "op": "select",
      "selector": "[name=\"bedrooms\"]",
      "param": "bedrooms",
      "precondition": {
        "selector_visible": "[name=\"bedrooms\"]"
      },
      "postcondition": {
        "field_equals": {
          "selector": "[name=\"bedrooms\"]",
          "param": "bedrooms"
        }
      },
      "id": "s13"
    },
    {
      "op": "click",
      "selector": "#continue",
      "precondition": {
        "selector_visible": "#continue"
      },
      "postcondition": {
        "selector_visible": "[name=\"savings\"]"
      },
      "id": "s14"
    },
    {
      "op": "fill",
      "selector": "[name=\"savings\"]",
      "param": "savings",
      "precondition": {
        "selector_visible": "[name=\"savings\"]"
      },
      "postcondition": {
        "field_equals": {
          "selector": "[name=\"savings\"]",
          "param": "savings"
        }
      },
      "id": "s15"
    },
    {
      "op": "fill",
      "selector": "[name=\"childcare\"]",
      "param": "childcare_monthly",
      "precondition": {
        "selector_visible": "[name=\"childcare\"]"
      },
      "postcondition": {
        "field_equals": {
          "selector": "[name=\"childcare\"]",
          "param": "childcare_monthly"
        }
      },
      "id": "s16"
    },
    {
      "op": "click",
      "selector": "#calculate",
      "precondition": {
        "selector_visible": "#calculate"
      },
      "postcondition": {
        "selector_visible": "#result-amount"
      },
      "timeout_ms": 8000,
      "id": "s17"
    },
    {
      "op": "extract",
      "name": "amount",
      "selector": "#result-amount",
      "pattern": "([0-9][0-9,.]*)",
      "as": "number",
      "precondition": {
        "selector_visible": "#result-amount"
      },
      "postcondition": {
        "selector_visible": "#result-amount"
      },
      "id": "s18"
    },
    {
      "op": "extract",
      "name": "status",
      "selector": "#result-status",
      "precondition": {
        "selector_visible": "#result-status"
      },
      "postcondition": {
        "selector_visible": "#result-status"
      },
      "id": "s19"
    },
    {
      "op": "extract",
      "name": "ref",
      "selector": "#result-ref",
      "precondition": {
        "selector_visible": "#result-ref"
      },
      "postcondition": {
        "selector_visible": "#result-ref"
      },
      "id": "s20"
    },
    {
      "op": "checkpoint",
      "name": "site_a_done",
      "resumable": true,
      "precondition": {
        "selector_visible": "#result-ref"
      },
      "postcondition": {
        "selector_visible": "#result-ref"
      },
      "id": "s21"
    },
    {
      "op": "click",
      "selector": "#cliff-btn",
      "precondition": {
        "selector_visible": "#cliff-btn"
      },
      "postcondition": {
        "selector_visible": "#cliff-panel li[data-cliff]"
      },
      "timeout_ms": 8000,
      "id": "s22"
    },
    {
      "op": "wait_for",
      "selector": "#cliff-panel li[data-cliff]",
      "precondition": {
        "selector_visible": "#cliff-btn"
      },
      "postcondition": {
        "selector_visible": "#cliff-panel"
      },
      "id": "s23"
    },
    {
      "op": "extract",
      "name": "cliff_panel",
      "selector": "#cliff-panel",
      "precondition": {
        "selector_visible": "#cliff-panel"
      },
      "postcondition": {
        "selector_visible": "#cliff-panel"
      },
      "id": "s24"
    }
  ]
}
