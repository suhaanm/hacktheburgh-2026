{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understudy.local/schema/queue_item.schema.json",
  "title": "Understudy approval queue item v1 (data/queue/<id>.json)",
  "description": "From docs/API_CONTRACT.md. Shared by the engine and the agent service; atomic writes. Evidence holds paths and small extracted values, never raw page text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "created_at", "routine_id", "run_id", "kind", "title", "summary", "risk_class", "evidence", "status", "decided_at", "decided_by"],
  "properties": {
    "id": { "type": "string", "pattern": "^q_[A-Za-z0-9_-]{1,32}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "routine_id": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]{2,40}$" },
    "run_id": { "type": "string", "pattern": "^r_[A-Za-z0-9_-]{1,32}$" },
    "kind": { "enum": ["irreversible_step", "outward_step", "batch_result", "injection_pause", "shadow_mismatch", "browser_step"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "risk_class": { "enum": ["irreversible", "outward", "normal"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenshots": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
        "extracted": { "type": "object" },
        "expected": { "type": "object" },
        "diff": { "type": "array" },
        "tier_log": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step", "tier"],
            "properties": { "step": { "type": "integer", "minimum": 0 }, "tier": { "enum": [1, 2, 3] } }
          }
        }
      }
    },
    "status": { "enum": ["pending", "approved", "rejected", "expired"] },
    "decided_at": { "type": ["string", "null"], "format": "date-time" },
    "decided_by": { "type": ["string", "null"], "maxLength": 40 }
  }
}
