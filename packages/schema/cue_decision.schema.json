                    "null"
                  ],
                  "maxLength": 40
                },
                "whisper": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 80,
                  "description": "8 words or fewer; only when the caller said voice_ok."
                },
                "whisper_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^whisper\\.[a-z][a-z0-9_.\\-]{0,63}$"
                }
              }
            }
          ]
        },
        "why": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path_prob",
            "margin",
            "p_stuck",
            "mastery",
            "level",
            "reasons"
          ],
          "properties": {
            "path_prob": {
