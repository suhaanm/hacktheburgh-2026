              "minimum": 0,
              "maximum": 1
            },
            "margin": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "p_stuck": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "mastery": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "reasons": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "enum": [
                  "no_consent",
                  "denied",
                  "quiet",
                  "flow",
                  "level_4",
                  "not_stuck",
                  "wait_signals",
