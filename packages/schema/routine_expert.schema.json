{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understudy.local/schema/routine_expert.schema.json",
  "title": "Understudy expert weekly routine template v1 (CAL-2)",
  "description": "packages/packs/<role>/routine_expert.yaml: the expert weekly structure for one role pack. The template is hand-authored from the planted synthetic design, not measured on real experts; every figure derived from it is labelled synthetic. slots is the expert's week in local time (batch windows, review slots, standing meetings, off-screen blocks). targets are the limits the suggestion catalogue compares a learner's week against (a minimum the expert keeps, or a maximum the expert stays under). synth holds generator hints only (title pools for the synthetic calendars, jitter); nothing in it is read by the analysis.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "role", "summary", "timezone", "work_window", "peak_focus", "slots", "targets"],
  "properties": {
    "version": { "const": 1 },
    "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$", "description": "Matches the pack id." },
    "summary": { "type": "string", "maxLength": 240 },
    "timezone": { "type": "string", "maxLength": 60, "description": "IANA zone the template and the synthetic expert calendars are written in." },
    "work_window": {
      "type": "object", "additionalProperties": false, "required": ["start", "end", "days"],
      "properties": { "start": { "$ref": "#/$defs/hm" }, "end": { "$ref": "#/$defs/hm" }, "days": { "type": "array", "items": { "$ref": "#/$defs/dow" }, "minItems": 1, "uniqueItems": true } }
    },
    "peak_focus": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": { "start": { "$ref": "#/$defs/hm" }, "end": { "$ref": "#/$defs/hm" }, "why": { "type": "string", "maxLength": 240 } }
    },
    "slots": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "kind", "days", "start", "end"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,30}$" },
          "kind": { "enum": ["meeting", "focus", "batch", "review", "offscreen", "break"] },
          "days": { "type": "array", "items": { "$ref": "#/$defs/dow" }, "minItems": 1, "uniqueItems": true },
          "start": { "$ref": "#/$defs/hm" },
          "end": { "$ref": "#/$defs/hm" },
          "recurring": { "type": "boolean" },
          "attendees": { "type": "integer", "minimum": 1, "maximum": 200 },
          "external": { "type": "boolean" },
          "optional": { "type": "boolean", "description": "May be skipped now and then by an expert (synthetic generator hint)." }
        }
      }
    },
    "targets": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "meeting_h_max": { "type": "number", "minimum": 0 },
        "meeting_share_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "focus_blocks_90_min": { "type": "integer", "minimum": 0 },
        "focus_blocks_60_min": { "type": "integer", "minimum": 0 },
        "longest_focus_min_min": { "type": "integer", "minimum": 0 },
        "fragmentation_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "fragmented_days_max": { "type": "integer", "minimum": 0 },
        "back_to_back_runs_max": { "type": "integer", "minimum": 0 },
        "work_span_h_max": { "type": "number", "minimum": 0 },
        "offscreen_h_min": { "type": "number", "minimum": 0 },
        "recurring_in_peak_h_max": { "type": "number", "minimum": 0 },
        "external_unbuffered_max": { "type": "integer", "minimum": 0 },
        "review_slots_min": { "type": "integer", "minimum": 0 },
        "batch_windows_min": { "type": "integer", "minimum": 0 },
        "outside_hours_h_max": { "type": "number", "minimum": 0 }
      },
      "required": ["meeting_h_max", "focus_blocks_90_min", "focus_blocks_60_min", "longest_focus_min_min", "fragmentation_max", "back_to_back_runs_max",
                   "offscreen_h_min", "recurring_in_peak_h_max", "external_unbuffered_max", "review_slots_min", "batch_windows_min", "outside_hours_h_max"]
    },
    "plugin_refs": {
      "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "id"],
        "properties": { "kind": { "enum": ["source", "skill"] }, "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$" } } },
      "description": "Source plugins (PLG-1) this template expects to read from: ics, jsoncal, graph_outlook (off by default)."
    },
    "synth": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "jitter_min": { "type": "integer", "minimum": 0, "maximum": 30 },
        "skip_prob": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "titles": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "minItems": 1 } }
      }
    }
  },
  "$defs": {
    "hm": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "dow": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
  }
}
