{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understudy.local/schema/pack.schema.json",
  "title": "Understudy role pack v1 (pack.yaml)",
  "description": "Spec 6.3. Validates pack.yaml. The files pack.yaml points at are validated against the sub-schemas in $defs (mapping, expert_steps, routine_templates, curriculum, persona, priors, task, household_generator, sites, sensitive_fields) using a ref such as pack.schema.json#/$defs/mapping. plugin_refs is accepted but never called (ROL-5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "version", "name", "summary", "depth", "onboarding", "cogs",
    "risk_classes", "routines", "tone_defaults", "curriculum", "persona", "priors"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/packId" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 2, "maxLength": 60 },
    "summary": { "type": "string", "minLength": 10, "maxLength": 200 },
    "depth": { "enum": ["deep", "thin"], "description": "Returned by GET /packs. Deep packs must also carry tasks, oracle and a full expert_policy." },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "onboarding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions"],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/question" },
          "description": "Exactly the five fixed ids tools, risky, tone, pace, hours (see GET /onboarding/questions). Prompts, options and defaults differ per pack."
        }
      }
    },
    "cogs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extra", "mapping"],
      "properties": {
        "extra": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/cogId" } },
        "mapping": { "$ref": "#/$defs/relPath" }
      }
    },
    "expert_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "coverage"],
      "properties": {
        "steps": { "$ref": "#/$defs/relPath" },
        "coverage": { "enum": ["full", "stub"], "description": "Deep packs: full. Thin packs: stub (a few checks, no oracle)." }
      }
    },
    "risk_classes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["irreversible", "outward", "sensitive_fields"],
      "properties": {
        "irreversible": { "$ref": "#/$defs/patternList" },
        "outward": { "$ref": "#/$defs/patternList" },
        "sensitive_fields": { "$ref": "#/$defs/relPath" }
      }
    },
    "routines": { "$ref": "#/$defs/relPath" },
    "tone_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "voice"],
      "properties": {
        "length": { "enum": ["short", "medium", "detailed"] },
        "voice": { "enum": ["plain", "precise", "terse", "direct", "warm"] },
        "pace": { "enum": ["gentle", "steady", "quick"] }
      }
    },
    "curriculum": { "$ref": "#/$defs/relPath" },
    "tasks": { "$ref": "#/$defs/relPath", "description": "Directory (deep packs): task.yaml, household_generator.yaml, sites.yaml." },
    "oracle": {
      "type": "string",
      "pattern": "^([A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*|[A-Za-z0-9_][A-Za-z0-9_./-]*\\.py)$",
      "description": "module:function (for example understudy_agent.sandbox_sites.oracle:score) or a path to a .py file. Deep packs only."
    },
    "persona": { "$ref": "#/$defs/relPath" },
    "priors": { "$ref": "#/$defs/relPath" },
    "plugin_refs": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/pluginRef" },
      "description": "Marketplace plugin references (skills as procedures, MCP servers as tools). Accepted, never called (ROL-5, D6)."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "depth": { "const": "deep" } }, "required": ["depth"] },
      "then": {
        "required": ["expert_policy", "tasks", "oracle"],
        "properties": { "expert_policy": { "properties": { "coverage": { "const": "full" } } } }
      }
    },
    {
      "if": { "properties": { "depth": { "const": "thin" } }, "required": ["depth"] },
      "then": { "properties": { "expert_policy": { "properties": { "coverage": { "const": "stub" } } } } }
    }
  ],

  "$defs": {
    "packId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "cogId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,30}$" },
    "baseCogId": { "enum": ["READ", "SEARCH", "REFORMULATE", "NAVIGATE", "ENTER", "COPY", "PASTE", "COMPARE", "CHECK", "DECIDE", "IDLE", "REVERT", "ASK"] },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,40}$" },
    "relPath": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_./-]*$",
      "description": "Relative to the pack directory. No leading slash, no '..'."
    },
    "patternList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 80 },
      "description": "Case-insensitive regex patterns matched against control labels."
    },
    "hours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "days"],
      "properties": {
        "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "days": {
          "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true,
          "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "$ref": "#/$defs/slug" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "default": { "type": "boolean" },
        "risk_class": { "enum": ["irreversible", "outward"], "description": "On a risky option: the class this answer adds to the person's memory file." },
        "patterns": { "$ref": "#/$defs/patternList", "description": "On a risky option: label patterns added to the person's risk classes." },
        "domain_role": { "$ref": "#/$defs/slug", "description": "On a tools option: the mapping.yaml domain role this answer registers." }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "kind"],
      "properties": {
        "id": { "enum": ["tools", "risky", "tone", "pace", "hours"] },
        "prompt": { "type": "string", "minLength": 8, "maxLength": 140 },
        "why": { "type": "string", "maxLength": 140 },
        "kind": { "enum": ["multi", "single", "hours"] },
        "options": { "type": "array", "minItems": 2, "maxItems": 10, "items": { "$ref": "#/$defs/option" } },
        "default_hours": { "$ref": "#/$defs/hours" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "enum": ["multi", "single"] } }, "required": ["kind"] }, "then": { "required": ["options"] } },
        { "if": { "properties": { "kind": { "const": "hours" } }, "required": ["kind"] }, "then": { "required": ["default_hours"] } }
      ]
    },
    "pluginRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_./#@:-]{1,120}$" },
        "kind": { "enum": ["plugin", "skill", "mcp_server"] },
        "source": { "type": "string", "maxLength": 120 },
        "version": { "type": "string", "maxLength": 32 },
        "license": { "type": "string", "maxLength": 32 },
        "as": { "enum": ["procedure", "tool"] },
        "enabled": { "type": "boolean", "default": false },
        "note": { "type": "string", "maxLength": 200 }
      }
    },

    "mapping": {
      "title": "cogs.mapping file (mapping.yaml)",
      "description": "Rule-based mapping from L0 events to cogs. Semantics: events are processed in time order. For each event the first rule in role_rules, then base_rules, whose `when` matches decides the cog (or ignore). `when` keys are AND-ed; a list value means any-of. domain_role and label_role are placeholders: hashes are per install, so the engine resolves them through a table {placeholder -> [hash,...]} (target.domain_hash, target.label_hash). `prev_cog` is the cog of the last non-ignored event (null at the start); `prev_type` the previous event's type; `within_s` bounds the gap to the previous event for prev_* tests. A segment for an event runs from its t to the next event's t, capped at segmentation.max_dwell_s, with a gap of at least segmentation.idle_s emitted as the idle cog. Consecutive segments with the same cog and a gap below segmentation.merge_gap_s merge.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "segmentation", "domain_roles", "label_roles", "role_rules", "base_rules"],
      "properties": {
        "version": { "const": 1 },
        "segmentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["merge_gap_s", "idle_s", "max_dwell_s"],
          "properties": {
            "merge_gap_s": { "type": "number", "exclusiveMinimum": 0 },
            "idle_s": { "type": "number", "exclusiveMinimum": 0 },
            "max_dwell_s": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "domain_roles": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/slug" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "hosts"],
            "properties": {
              "label": { "type": "string", "maxLength": 80 },
              "hosts": {
                "type": "array", "minItems": 1,
                "items": { "type": "string", "pattern": "^[a-z0-9.*-]+(:[0-9]{2,5})?$" },
                "description": "Host (hostname[:port], lower case, * wildcard allowed) the per-install hasher turns into domain_hash for this role. Hosts never appear in events."
              }
            }
          }
        },
        "label_roles": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/slug" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vocab"],
            "properties": {
              "vocab": {
                "type": "array", "minItems": 1,
                "items": { "type": "string", "minLength": 1, "maxLength": 40 },
                "description": "Normalised (trimmed, lower case) control labels hashed with the per-install salt to build the label_hash table for this role. Sensitive-field vocabulary must never appear here."
              }
            }
          }
        },
        "role_rules": { "type": "array", "items": { "$ref": "#/$defs/mapRule" } },
        "base_rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mapRule" } },
        "examples": {
          "type": "array",
          "description": "Test vectors for the cog mapper. hash_roles resolves placeholders to the hashes used in the example events.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "hash_roles", "events", "expect"],
            "properties": {
              "name": { "type": "string" },
              "hash_roles": {
                "type": "object",
                "properties": {
                  "domain": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
                  "label": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
                },
                "additionalProperties": false
              },
              "events": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["dt", "type"],
                  "properties": {
                    "dt": { "type": "number", "minimum": 0, "description": "Seconds since the previous event." },
                    "type": { "type": "string" },
                    "actor": { "enum": ["human", "agent"] },
                    "target": { "type": "object" },
                    "meta": { "type": "object" }
                  }
                }
              },
              "expect": { "type": "array", "items": { "type": ["string", "null"] }, "description": "One entry per event: the cog id, or null when the event is ignored." }
            }
          }
        }
      }
    },
    "mapRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "type": { "$ref": "#/$defs/strOrList" },
            "actor": { "enum": ["human", "agent"] },
            "target_role": { "$ref": "#/$defs/strOrList" },
            "domain_role": { "$ref": "#/$defs/strOrList" },
            "label_role": { "$ref": "#/$defs/strOrList" },
            "meta": { "type": "object", "additionalProperties": { "$ref": "#/$defs/metaTest" } },
            "prev_cog": { "$ref": "#/$defs/strOrList" },
            "not_prev_cog": { "$ref": "#/$defs/strOrList" },
            "prev_type": { "$ref": "#/$defs/strOrList" },
            "within_s": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "cog": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,30}$" },
        "ignore": { "const": true }
      },
      "oneOf": [{ "required": ["cog"] }, { "required": ["ignore"] }]
    },
    "strOrList": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 40 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 40 } }
      ]
    },
    "metaTest": {
      "oneOf": [
        { "type": ["number", "string", "boolean"] },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": { "gte": { "type": "number" }, "lte": { "type": "number" }, "gt": { "type": "number" }, "lt": { "type": "number" } }
        }
      ]
    },

    "expert_steps": {
      "title": "Expert policy (expert_steps.yaml)",
      "description": "Ordered checks forming a partial order. A check lists the cogs an expert performs for it (in order) and the checks it must come after. Any linear extension of the partial order is an allowed ordering, so independent checks may be reordered. critical checks are the ones the critic and the coach insist on; skipping one is a deficit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "task", "coverage", "checks"],
      "properties": {
        "version": { "const": 1 },
        "task": { "$ref": "#/$defs/slug" },
        "coverage": { "enum": ["full", "stub"] },
        "checks": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "cogs", "label", "required", "after"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "label": { "type": "string", "maxLength": 100 },
              "cogs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cogId" } },
              "required": { "type": "boolean" },
              "critical": { "type": "boolean" },
              "after": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
              "skill": { "$ref": "#/$defs/slug", "description": "Curriculum skill this check exercises." },
              "expert_median_s": { "type": "number", "exclusiveMinimum": 0 },
              "coach": {
                "type": "object",
                "additionalProperties": false,
                "required": ["question"],
                "properties": {
                  "question": { "type": "string", "maxLength": 160, "description": "A hypothesis or question for the nudge, never the answer (COA-4)." },
                  "hint": { "type": "string", "maxLength": 160 }
                }
              }
            }
          }
        },
        "allowed_reorderings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "description": { "type": "string", "maxLength": 200 },
              "permutable": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "description": "Checks that may occur in any order relative to each other (informational; the partial order is authoritative)." }
            }
          }
        }
      }
    },

    "routine_templates": {
      "title": "Routine templates (routines.yaml)",
      "description": "Templates the routine finder matches. A cluster centroid matches a template when the normalised alignment distance between cog sequences is at most match_distance.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "templates"],
      "properties": {
        "version": { "const": 1 },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_support": { "type": "integer", "minimum": 2 },
            "judgement_cogs": { "type": "array", "items": { "$ref": "#/$defs/cogId" } },
            "wage_gbp_per_h": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "templates": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "cogs", "match_distance", "automatable", "learning_relevant", "touches", "never", "proposal"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$" },
              "title": { "type": "string", "maxLength": 80 },
              "cogs": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/cogId" } },
              "match_distance": { "type": "number", "minimum": 0, "maximum": 1 },
              "min_support": { "type": "integer", "minimum": 2 },
              "judgement_cogs": { "type": "array", "items": { "$ref": "#/$defs/cogId" } },
              "automatable": { "type": "boolean", "description": "False: the finder reports it but never proposes automation (too much judgement)." },
              "learning_relevant": { "type": "boolean", "description": "True: skill gate applies, the worker's mastery of skill_cogs must be level 4 first." },
              "skill_cogs": { "type": "array", "items": { "$ref": "#/$defs/cogId" } },
              "touches": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 60 } },
              "never": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 60 } },
              "params": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "description": "Parameter slots the L1 recording replaces values with." },
              "value_defaults": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "manual_minutes_per_run": { "type": "number", "exclusiveMinimum": 0 },
                  "build_cost_runs": { "type": "number", "exclusiveMinimum": 0, "description": "Ski rental buy cost b in units of one manual run." },
                  "maintenance_risk_gbp": { "type": "number", "minimum": 0 },
                  "error_cost_gbp": { "type": "number", "minimum": 0 }
                }
              },
              "proposal": {
                "type": "object",
                "additionalProperties": false,
                "required": ["what"],
                "properties": {
                  "what": { "type": "string", "maxLength": 240 }
                }
              }
            }
          }
        }
      }
    },

    "curriculum": {
      "title": "Curriculum (curriculum.yaml)",
      "description": "Skills in teaching order. ladder maps each help level to the chip the overlay shows. Each skill carries a short prompt per level: a hypothesis or question, not the answer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "ladder", "skills"],
      "properties": {
        "version": { "const": 1 },
        "ladder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["L1", "L2", "L3", "L4"],
          "properties": {
            "L1": { "const": "full" }, "L2": { "const": "small" }, "L3": { "const": "dot" }, "L4": { "const": "gone" }
          }
        },
        "skills": {
          "type": "array", "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "order", "cogs", "prerequisites", "prompts"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "label": { "type": "string", "maxLength": 80 },
              "order": { "type": "integer", "minimum": 1 },
              "cogs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cogId" } },
              "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
              "expert_signal": { "type": "string", "maxLength": 140 },
              "prompts": {
                "type": "object",
                "additionalProperties": false,
                "required": ["L1", "L2", "L3"],
                "properties": {
                  "L1": { "type": "string", "maxLength": 200 },
                  "L2": { "type": "string", "maxLength": 140 },
                  "L3": { "type": "string", "maxLength": 80 }
                }
              }
            }
          }
        }
      }
    },

    "persona": {
      "title": "Persona parameters (persona.yaml)",
      "description": "Parameters for the synthetic persona and apprentice generators. The generator must use a different mechanism from the fitting models. apprentice.deficits are the planted truth for EVL-1 (which deficit was injected and what it cost).",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tasks_per_active_hour", "cog_dwell_s", "apprentice", "planted_routines"],
      "properties": {
        "version": { "const": 1 },
        "task": { "$ref": "#/$defs/slug" },
        "tasks_per_active_hour": { "$ref": "#/$defs/meanSd" },
        "cog_dwell_s": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/cogId" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expert_median_s", "sigma"],
            "properties": {
              "expert_median_s": { "type": "number", "exclusiveMinimum": 0 },
              "sigma": { "type": "number", "exclusiveMinimum": 0, "description": "Log-normal sigma." },
              "novice_multiplier": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "apprentice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skill_curve", "deficits"],
          "properties": {
            "skill_curve": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "plateau", "half_life_cases"],
              "properties": {
                "start": { "type": "number", "minimum": 0, "maximum": 1 },
                "plateau": { "type": "number", "minimum": 0, "maximum": 1 },
                "half_life_cases": { "type": "number", "exclusiveMinimum": 0 }
              }
            },
            "deficits": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "kind", "cogs", "p_at_skill0", "price_s", "skill"],
                "properties": {
                  "id": { "$ref": "#/$defs/slug" },
                  "label": { "type": "string", "maxLength": 100 },
                  "kind": { "enum": ["insert", "omit", "slow", "swap"] },
                  "cogs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cogId" } },
                  "insert_before": { "$ref": "#/$defs/cogId" },
                  "multiplier": { "type": "number", "exclusiveMinimum": 0 },
                  "p_at_skill0": { "type": "number", "minimum": 0, "maximum": 1, "description": "Probability the deficit shows on a case at skill 0; it falls as skill rises." },
                  "price_s": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["mean", "sd"],
                    "properties": { "mean": { "type": "number" }, "sd": { "type": "number", "minimum": 0 } },
                    "description": "Planted truth: mean extra seconds per case when present (direct time plus expected rework)."
                  },
                  "skill": { "$ref": "#/$defs/slug", "description": "Curriculum skill that fixes it." }
                }
              }
            }
          }
        },
        "stuck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_hazard_per_bin": { "type": "number", "minimum": 0, "maximum": 1 },
            "skill_effect": { "type": "number", "minimum": 0 }
          }
        },
        "planted_routines": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "template", "daily_rate", "preferred_hours", "duration_s"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$" },
              "template": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$" },
              "daily_rate": { "type": "number", "exclusiveMinimum": 0 },
              "preferred_hours": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 23 } },
              "duration_s": {
                "type": "object",
                "additionalProperties": false,
                "required": ["median", "sigma"],
                "properties": { "median": { "type": "number", "exclusiveMinimum": 0 }, "sigma": { "type": "number", "exclusiveMinimum": 0 } }
              },
              "param_variation": { "type": "array", "items": { "$ref": "#/$defs/slug" } }
            }
          }
        }
      }
    },
    "meanSd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "sd"],
      "properties": { "mean": { "type": "number" }, "sd": { "type": "number", "minimum": 0 } }
    },
    "betaPrior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alpha", "beta"],
      "properties": { "alpha": { "type": "number", "exclusiveMinimum": 0 }, "beta": { "type": "number", "exclusiveMinimum": 0 } }
    },

    "priors": {
      "title": "Role-level priors (priors.yaml)",
      "description": "Priors for partial pooling (ANA-9, ROL-6). pooling.strength is the number of pseudo-observations the role prior is worth.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "pooling", "stuck_hazard", "mastery", "accept", "routines_per_week", "presence"],
      "properties": {
        "version": { "const": 1 },
        "pooling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strength"],
          "properties": { "strength": { "type": "number", "exclusiveMinimum": 0 } }
        },
        "stuck_hazard": { "$ref": "#/$defs/betaPrior" },
        "mastery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "decay_half_life_days"],
          "properties": {
            "start": { "type": "number", "minimum": 0, "maximum": 1 },
            "decay_half_life_days": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "accept": { "$ref": "#/$defs/betaPrior" },
        "routines_per_week": { "$ref": "#/$defs/meanSd" },
        "presence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hours", "active_in_hours", "active_out_of_hours"],
          "properties": {
            "hours": { "$ref": "#/$defs/hours" },
            "active_in_hours": { "type": "number", "minimum": 0, "maximum": 1 },
            "active_out_of_hours": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "cog_dwell_s": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/cogId" },
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },

    "task": {
      "title": "Task definition (tasks/task.yaml)",
      "description": "Deep packs. The task the oracle scores and the completion check (AGT-4) verifies. goal_tokens name what the final observation must contain; code, not a model, checks them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "name", "goal", "steps", "result_fields", "goal_tokens", "stop_before"],
      "properties": {
        "version": { "const": 1 },
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "maxLength": 80 },
        "goal": { "type": "string", "maxLength": 240 },
        "steps": { "type": "array", "minItems": 3, "items": { "type": "string", "maxLength": 120 } },
        "result_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "goal_tokens": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "maxLength": 80 },
          "description": "Placeholders such as {case_ref} and {result:<field>@<site>} the final observation must contain."
        },
        "stop_before": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 60 } },
        "progress_events": { "type": "array", "items": { "type": "string", "maxLength": 100 } }
      }
    },
    "household_generator": {
      "title": "Household generator config (tasks/household_generator.yaml)",
      "description": "Synthetic households only. Config for the generator in the agent service. Cliff edges are planted on purpose; the oracle is authoritative for the numbers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "seed", "default_count", "fields", "cliffs"],
      "properties": {
        "version": { "const": 1 },
        "seed": { "type": "integer" },
        "default_count": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "case_ref_format": { "type": "string", "pattern": "^[A-Z]{2}-\\{[0-9]+d\\}$" },
        "fields": {
          "type": "object",
          "minProperties": 3,
          "propertyNames": { "$ref": "#/$defs/slug" },
          "additionalProperties": {
            "type": "object",
            "required": ["dist"],
            "properties": {
              "dist": { "enum": ["choice", "int", "lognormal", "bernoulli", "list"] },
              "values": { "type": "array" },
              "weights": { "type": "array", "items": { "type": "number", "minimum": 0 } },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "median": { "type": "number" },
              "sigma": { "type": "number" },
              "p": { "type": "number", "minimum": 0, "maximum": 1 },
              "round_to": { "type": "number" },
              "depends_on": { "type": "object" },
              "note": { "type": "string" }
            }
          }
        },
        "cliffs": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "field", "threshold", "band", "plant_rate"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "field": { "$ref": "#/$defs/slug" },
              "threshold": { "type": "number" },
              "band": { "type": "number", "exclusiveMinimum": 0, "description": "Households are planted within threshold +- band." },
              "plant_rate": { "type": "number", "minimum": 0, "maximum": 1 },
              "note": { "type": "string", "maxLength": 160 }
            }
          }
        },
        "constraints": { "type": "array", "items": { "type": "string", "maxLength": 160 } }
      }
    },
    "sites": {
      "title": "Sandbox sites (tasks/sites.yaml)",
      "description": "Ports and variants of the local sandbox sites (7801 to 7803). The agent-core track owns the sites; this file is the pack's declaration of what the task expects.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sites", "variants"],
      "properties": {
        "version": { "const": 1 },
        "sites": {
          "type": "array", "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "port", "kind", "label", "domain_role"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "port": { "type": "integer", "minimum": 7801, "maximum": 7803 },
              "kind": { "enum": ["calculator", "case_note"] },
              "label": { "type": "string", "maxLength": 60 },
              "domain_role": { "$ref": "#/$defs/slug" },
              "path": { "type": "string", "pattern": "^/[A-Za-z0-9_./-]*$" }
            }
          }
        },
        "variants": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clean", "injected"],
          "properties": {
            "clean": { "type": "string", "maxLength": 80 },
            "injected": { "type": "string", "maxLength": 80 }
          }
        }
      }
    },

    "sensitive_fields": {
      "title": "Sensitive fields list (global or pack level)",
      "description": "Same shape as packages/schema/sensitive_fields.json. Pack-level files add patterns; the effective list is the union of the global list and the pack list. Patterns are case-insensitive regexes over field name, id, label, placeholder, autocomplete and aria-label.",
      "type": "object",
      "required": ["patterns"],
      "properties": {
        "description": { "type": "string" },
        "extends": { "type": "string", "pattern": "^(?!.*\\.\\.[^/])[A-Za-z0-9_./-]+$" },
        "patterns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "autocomplete_tokens": { "type": "array", "items": { "type": "string" } },
        "input_types": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
