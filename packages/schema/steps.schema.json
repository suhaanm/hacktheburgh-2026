{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understudy.local/schema/steps.schema.json",
  "title": "Understudy routine bundle: JSON step DSL v1",
  "description": "A routine bundle (data/routines/<id>/steps.json). Bundles are data, never code: a small interpreter runs these steps in a separate Playwright context and model-generated code is never executed. Ops: goto, click, fill, select, wait_for, assert_text, extract, checkpoint. Every step has a precondition and a postcondition; a failed precondition escalates to the next tier (AGT-3). Values enter only through params (slots), never as literals for personal data; params marked sensitive are supplied at run time and never saved. L1 recording never records fields in sensitive_fields.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "role", "params", "steps"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$", "description": "The routine id, e.g. calc-entry-3x." },
    "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "title": { "type": "string", "maxLength": 100 },
    "created_from": { "type": "string", "maxLength": 80, "description": "Recording id or template id. A model may draft a bundle; the validator checks every selector and param and a dry run must pass." },
    "never": {
      "type": "array",
      "items": { "type": "string", "maxLength": 60 },
      "description": "Actions the bundle must never perform (for example submit). The gate enforces these in code."
    },
    "params": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/ident" },
      "additionalProperties": { "$ref": "#/$defs/param" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/step" }
    }
  },

  "$defs": {
    "ident": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
    "stepId": { "type": "string", "pattern": "^s[0-9]{1,3}$" },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "integer", "number", "boolean", "enum"] },
        "source": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$", "description": "Where the value comes from at run time, for example household.adults. Omit for values supplied by the caller." },
        "values": { "type": "array", "minItems": 1, "items": { "type": ["string", "number"] }, "description": "Allowed values when type is enum." },
        "default": { "type": ["string", "number", "boolean", "null"] },
        "sensitive": { "type": "boolean", "description": "True: never written to disk, logs or the audit file." }
      },
      "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
      "then": { "required": ["values"] }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "All present keys must hold (AND). always:true is a condition that always passes (allowed on the first step).",
      "properties": {
        "always": { "const": true },
        "url_contains": { "type": "string", "maxLength": 120 },
        "title_contains": { "type": "string", "maxLength": 120 },
        "selector_visible": { "$ref": "#/$defs/selector" },
        "selector_absent": { "$ref": "#/$defs/selector" },
        "text_contains": { "$ref": "#/$defs/textMatch" },
        "text_absent": { "$ref": "#/$defs/textMatch" },
        "field_equals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selector", "param"],
          "properties": { "selector": { "$ref": "#/$defs/selector" }, "param": { "$ref": "#/$defs/ident" } }
        }
      }
    },
    "selector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "not": { "pattern": "^\\s*([jJ][aA][vV][aA][sS][cC][rR][iI][pP][tT]|[dD][aA][tT][aA]):" },
      "description": "A CSS selector. The compile validator checks each one against the live page."
    },
    "textMatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "param": { "$ref": "#/$defs/ident" },
        "literal": { "type": "string", "minLength": 1, "maxLength": 120 }
      },
      "oneOf": [{ "required": ["param"] }, { "required": ["literal"] }]
    },
    "stepCommon": {
      "type": "object",
      "required": ["id", "op", "precondition", "postcondition"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "op": { "type": "string" },
        "precondition": { "$ref": "#/$defs/condition" },
        "postcondition": { "$ref": "#/$defs/condition" },
        "irreversible": { "type": "boolean", "description": "Marks a step the action-class gate must stop for a human click unless the worker opted this routine in (D11)." },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "note": { "type": "string", "maxLength": 120 }
      }
    },
    "targetSel": {
      "oneOf": [
        { "required": ["selector"], "not": { "anyOf": [{ "required": ["role"] }, { "required": ["name"] }] } },
        { "required": ["role", "name"], "not": { "required": ["selector"] } }
      ]
    },
    "targetProps": {
      "properties": {
        "selector": { "$ref": "#/$defs/selector" },
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/stepGoto" },
        { "$ref": "#/$defs/stepClick" },
        { "$ref": "#/$defs/stepFill" },
        { "$ref": "#/$defs/stepSelect" },
        { "$ref": "#/$defs/stepWaitFor" },
        { "$ref": "#/$defs/stepAssertText" },
        { "$ref": "#/$defs/stepExtract" },
        { "$ref": "#/$defs/stepCheckpoint" }
      ]
    },
    "stepGoto": {
      "allOf": [
        { "$ref": "#/$defs/stepCommon" },
        {
          "properties": {
            "op": { "const": "goto" },
            "url": { "type": "string", "pattern": "^https?://[A-Za-z0-9._:/?=&%#-]+$", "maxLength": 300 },
            "url_param": { "$ref": "#/$defs/ident" }
          },
          "oneOf": [{ "required": ["url"] }, { "required": ["url_param"] }]
        }
      ],
      "unevaluatedProperties": false
    },
    "stepClick": {
      "allOf": [
        { "$ref": "#/$defs/stepCommon" },
        { "$ref": "#/$defs/targetProps" },
        { "$ref": "#/$defs/targetSel" },
        { "properties": { "op": { "const": "click" } } }
      ],
      "unevaluatedProperties": false
    },
    "stepFill": {
      "allOf": [
        { "$ref": "#/$defs/stepCommon" },
        { "$ref": "#/$defs/targetProps" },
        { "$ref": "#/$defs/targetSel" },
        {
          "required": ["param"],
          "properties": {
            "op": { "const": "fill" },
            "param": { "$ref": "#/$defs/ident" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stepSelect": {
      "allOf": [
        { "$ref": "#/$defs/stepCommon" },
        { "$ref": "#/$defs/targetProps" },
        { "$ref": "#/$defs/targetSel" },
        {
          "properties": {
            "op": { "const": "select" },
            "param": { "$ref": "#/$defs/ident" },
            "option": { "type": "string", "minLength": 1, "maxLength": 80 }
          },
          "oneOf": [{ "required": ["param"] }, { "required": ["option"] }]
        }
      ],
      "unevaluatedProperties": false
    },
    "stepWaitFor": {
      "allOf": [
        { "$ref": "#/$defs/stepCommon" },
        {
          "properties": {
            "op": { "const": "wait_for" },
            "selector": { "$ref": "#/$defs/selector" },
            "text": { "$ref": "#/$defs/textMatch" },
            "url_contains": { "type": "string", "maxLength": 120 }
          },
          "oneOf": [{ "required": ["selector"] }, { "required": ["text"] }, { "required": ["url_contains"] }]
        }
      ],
      "unevaluatedProperties": false
    },
    "stepAssertText": {
      "allOf": [
        { "$ref": "#/$defs/stepCommon" },
        {
          "properties": {
            "op": { "const": "assert_text" },
            "selector": { "$ref": "#/$defs/selector" },
            "param": { "$ref": "#/$defs/ident" },
            "literal": { "type": "string", "minLength": 1, "maxLength": 120 }
          },
          "oneOf": [{ "required": ["param"] }, { "required": ["literal"] }]
        }
      ],
      "unevaluatedProperties": false
    },
    "stepExtract": {
      "allOf": [
        { "$ref": "#/$defs/stepCommon" },
        {
          "required": ["name", "selector"],
          "properties": {
            "op": { "const": "extract" },
            "name": { "$ref": "#/$defs/ident" },
            "selector": { "$ref": "#/$defs/selector" },
            "pattern": { "type": "string", "maxLength": 120, "description": "Optional regex; the first capture group is stored." },
            "as": { "enum": ["string", "number"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stepCheckpoint": {
      "allOf": [
        { "$ref": "#/$defs/stepCommon" },
        {
          "required": ["name"],
          "properties": {
            "op": { "const": "checkpoint" },
            "name": { "$ref": "#/$defs/ident" },
            "resumable": { "type": "boolean", "description": "True: an off-hours run may resume from here after a yield (OFF-3)." }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
