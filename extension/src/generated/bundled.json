            "zone": "case_note",
            "selector": "form[action^=\"/casenote\"], #note-id, #note-status, #note-body, #cn-id, #cn-state, #cn-text"
          },
          {
            "zone": "calc_result",
            "selector": "#result-amount, #result-status, #result-ref, #calc-total, #calc-outcome, #calc-reference"
          },
          {
            "zone": "household_form",
            "selector": "form[action^=\"/step\"], form[action^=\"/result\"]"
