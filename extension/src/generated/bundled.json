            "zone": "calc_result",
            "when": "#result-amount, #calc-total"
          },
          {
            "zone": "household_form",
            "when": "form[action^=\"/step\"], form[action^=\"/result\"]"
          }
        ],
        "markers": {
          "task_start": {
            "zone": "calc_site",
            "idle_s": 120
          },
          "progress": [
            {
              "kind": "result_read",
              "when": "#result-amount, #calc-total"
            },
            {
              "kind": "note_field",
              "when": "#note-status, #cn-state"
