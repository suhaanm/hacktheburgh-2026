{
  "sensitive": [
    {
      "description": "Fields that are NEVER recorded or read (CAP-4, SEC). Data, not code: extend freely. Matched case-insensitively as regex against field name, id, label, placeholder, autocomplete and aria-label.",
      "patterns": [
        "pass(word|wd|code|phrase)?",
        "\\bpin\\b",
        "\\botp\\b",
        "one[- ]?time",
        "2fa|mfa|verification[- ]code|security[- ]code",
        "\\bcvv\\b|\\bcvc\\b|card[- ]?(number|no)|credit|debit",
        "\\biban\\b|sort[- ]?code|account[- ]?(number|no)|routing",
        "national[- ]?insurance|\\bni[- ]?(number|no)\\b|\\bnino\\b|\\bssn\\b|social[- ]security",
        "passport|driving[- ]?licen[cs]e|date[- ]of[- ]birth|\\bdob\\b",
        "secret|token|api[- ]?key|private[- ]key|seed[- ]phrase",
        "cc-number|cc-csc|cc-exp|current-password|new-password|one-time-code"
      ],
      "autocomplete_tokens": [
        "cc-number",
        "cc-csc",
        "cc-exp",
        "current-password",
        "new-password",
        "one-time-code"
      ],
      "input_types": [
        "password"
      ]
    },
    {
      "description": "Benefits-processor additions to the global sensitive-fields list. The effective list is the union of this file and packages/schema/sensitive_fields.json. Data, not code: extend freely. Patterns are case-insensitive regexes over field name, id, label, placeholder, autocomplete and aria-label.",
      "extends": "../../schema/sensitive_fields.json",
      "patterns": [
        "\\bnino\\b|national[- ]?insurance|\\bni[- ]?(no|number)\\b",
        "claimant[- ]?(name|surname|forename|address|phone|email)",
        "(partner|spouse|child|children|dependant)[- ]?(name|dob|date[- ]of[- ]birth)",
        "(home|postal|street)[- ]?address|\\bpostcode\\b|\\bpost[- ]?code\\b|\\bzip\\b",
        "\\bphone\\b|\\bmobile\\b|\\bemail\\b",
        "\\butr\\b|unique[- ]?taxpayer|tax[- ]?(code|reference)",
        "bank[- ]?(name|details)|payee|direct[- ]?debit",
        "medical|diagnos|health[- ]?condition|disability[- ]?(type|detail)|\\bpip\\b[- ]?(ref|reference)",
        "immigration|visa|biometric|right[- ]to[- ]rent|residence[- ]permit",
        "benefit[- ]?claim[- ]?(ref|reference|number)|universal[- ]?credit[- ]?(ref|id)"
      ],
      "autocomplete_tokens": [
        "street-address",
        "address-line1",
        "address-line2",
        "postal-code",
        "tel",
        "email",
        "bday"
      ],
      "input_types": [
        "password",
        "tel",
        "email"
      ]
    },
    {
      "description": "Data-analyst additions to the global sensitive-fields list. The effective list is the union of this file and packages/schema/sensitive_fields.json. Patterns are case-insensitive regexes over field name, id, label, placeholder, autocomplete and aria-label. Role-depth additions (7 Nov 2026): row-level identifiers and personal columns that show up in profile and lineage panels. Finding editors, metric descriptions and review boxes are deliberately NOT listed: the capture never reads their text, and listing them would drop the events that make WRITE_FINDING, DOCUMENT_METRIC and PEER_CHECK visible.",
      "extends": "../../schema/sensitive_fields.json",
      "patterns": [
        "connection[- ]?string|dsn|jdbc",
        "warehouse[- ]?(user|password|key)|service[- ]?account|credentials?",
        "access[- ]?key|secret[- ]?key|bearer",
        "(customer|user|patient|employee)[- ]?(name|email|phone|address|id)",
        "\\bemail\\b|\\bphone\\b|\\bmobile\\b|\\bpostcode\\b|\\bpost[- ]?code\\b",
        "\\bsalary\\b|\\bdate[- ]?of[- ]?birth\\b|\\bdob\\b|national[- ]?insurance|\\bssn\\b",
        "row[- ]?level|sample[- ]?rows?|\\bpii\\b"
      ],
      "autocomplete_tokens": [
        "email",
        "tel",
        "street-address",
        "postal-code"
      ],
      "input_types": [
        "password",
        "email",
        "tel"
      ]
    },
    {
      "description": "Programmer additions to the global sensitive-fields list. The effective list is the union of this file and packages/schema/sensitive_fields.json. Patterns are case-insensitive regexes over field name, id, label, placeholder, autocomplete and aria-label. Role-depth additions (7 Nov 2026): database and secret fields. Commit message, pull request and review comment boxes are deliberately NOT listed: the capture never reads their text, and listing them would drop the events that make WRITE_COMMIT_MSG, OPEN_PR and ANSWER_REVIEW visible.",
      "extends": "../../schema/sensitive_fields.json",
      "patterns": [
        "personal[- ]?access[- ]?token|\\bpat\\b|deploy[- ]?key|ssh[- ]?key|gpg|signing[- ]?key",
        "env(ironment)?[- ]?(var|variable)s?[- ]?(value|secret)|\\.env",
        "client[- ]?secret|webhook[- ]?secret|bearer|authorization",
        "recovery[- ]?code|backup[- ]?code",
        "\\bemail\\b",
        "database[- ]?url|connection[- ]?string|\\bdsn\\b|\\bjdbc\\b",
        "secret[- ]?(name|value)|\\bvault\\b|api[- ]?key|access[- ]?token"
      ],
      "autocomplete_tokens": [
        "email"
      ],
      "input_types": [
        "password",
        "email"
      ]
    }
  ],
