      {
        "pack": "benefits-processor",
        "id": "a",
        "hosts": [
          "127.0.0.1:7801",
          "localhost:7801"
        ],
        "nav_default": "calc_site",
        "tab_default": "results_tabs",
        "nav": [
          {
            "zone": "case_note",
            "when": "form[action^=\"/casenote\"], #note-id, #cn-id"
          },
          {
            "zone": "calc_result",
            "when": "#result-amount, #calc-total"
          },
          {
            "zone": "household_form",
            "when": "form input[type=\"hidden\"]"
          }
        ],
        "tab": [
          {
            "zone": "case_note",
            "when": "form[action^=\"/casenote\"], #note-id, #cn-id"
          }
        ],
        "page": [
          {
            "zone": "case_note",
            "when": "form[action^=\"/casenote\"], #note-id, #cn-id"
          },
          {
            "zone": "calc_result",
            "when": "#result-amount, #calc-total"
          },
          {
            "zone": "household_form",
            "when": "form[action^=\"/step\"], form[action^=\"/result\"]"
          }
        ],
        "markers": {
          "task_start": {
            "zone": "calc_site",
            "idle_s": 120
          },
          "progress": [
            {
              "kind": "result_read",
              "when": "#result-amount, #calc-total"
            },
            {
              "kind": "note_field",
              "when": "#note-status, #cn-state"
            }
          ],
          "task_end": {
            "when": "#note-status, #cn-state",
            "reason": "note_saved"
          }
        },
        "elements": [
          {
            "zone": "cliff_button",
            "selector": "#cliff-btn"
          },
          {
            "zone": "cliff_panel",
            "selector": "#cliff-panel"
          },
          {
            "zone": "reconcile_control",
