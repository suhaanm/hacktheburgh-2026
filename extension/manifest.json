{
  "manifest_version": 3,
  "name": "Understudy capture",
  "version": "0.1.0",
  "description": "Understudy's browser capture. Off until you turn it on. Sends hashed, text-free activity events to your own machine only.",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": ["storage", "alarms", "webNavigation"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "action": { "default_title": "Understudy capture", "default_popup": "popup.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:* http://localhost:*"
  }
}
