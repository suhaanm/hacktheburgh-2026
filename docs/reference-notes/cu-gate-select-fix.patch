diff -ru a/services/agent/understudy_agent/security/drift.py b/services/agent/understudy_agent/security/drift.py
--- a/services/agent/understudy_agent/security/drift.py	2026-11-07 15:49:38
+++ b/services/agent/understudy_agent/security/drift.py	2026-11-07 21:35:03
@@ -23,7 +23,9 @@
     "required": ["serves_goal", "reason"],
     "properties": {
         "serves_goal": {"type": "boolean"},
-        "reason": {"type": "string", "maxLength": 200},
+        "reason": {"type": "string"},          # the 200-character cap is applied to the STORED text below (safe_label), not as a validation rule:
+                                               # maxLength is stripped from the provider's strict schema, so the model never sees it, and an
+                                               # over-long reason used to raise SchemaViolation and read as "the goal check could not run"
     },
 }
 
@@ -87,8 +89,9 @@
         prompt = _PROMPT.format(goal=safe_label(goal, 300), recent=safe_label(recent_txt, 400), step=step.render())
         try:
             out = self.port.check(prompt, DRIFT_SCHEMA)
-        except (ProviderError, ValueError):
-            return DriftVerdict(False, "the goal check could not run; pausing to be safe", "unavailable")
+        except (ProviderError, ValueError) as exc:
+            # still fails closed; the exception CLASS (never its message) is kept so a stop can be told apart: SchemaViolation, ModelRefusal, a provider error
+            return DriftVerdict(False, f"the goal check could not run ({type(exc).__name__}); pausing to be safe", "unavailable")
         ok = bool(out.get("serves_goal"))
         return DriftVerdict(ok, safe_label(str(out.get("reason", "")), 200), "model")
 
